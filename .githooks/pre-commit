#!/bin/bash
# Pre-commit hook:
#   1. Auto-format staged JSON files (4-space indent)
#   2. Check for private keys and sensitive URLs

staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep "\.json$" || true)

if [ -z "$staged_files" ]; then
    exit 0
fi

for file in $staged_files; do
    if [ -f "$file" ]; then
        if python3 scripts/format_config.py "$file"; then
            git add "$file"
        fi

        if ! git show ":$file" | python3 scripts/check_config.py; then
            echo "   File: $file"
            echo ""
            exit 1
        fi

        if ! python3 scripts/validate_config.py "$file"; then
            exit 1
        fi
    fi
done

exit 0
